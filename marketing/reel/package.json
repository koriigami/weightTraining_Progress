{
  "name": "levl-reel",
  "private": true,
  "description": "Levl marketing reels made with Remotion. Separate from the app.",
  "scripts": {
    "assets": "mkdir -p public && cp ../../docs/marketing/*.png ../../public/fonts/*.woff2 public/",
